{
  "name": "@cfal/noise-ws",
  "version": "0.1.0",
  "description": "Bun WebSockets with mandatory Noise PSK encryption for Garcon execution nodes",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/cfal/noise-ws.git" },
  "engines": { "bun": ">=1.4.2" },
  "types": "./types/index.d.ts",
  "exports": { ".": { "types": "./types/index.d.ts", "default": "./src/index.ts" } },
  "files": ["src", "types", "README.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "bun test --max-concurrency=1 --timeout=15000 test",
    "test:interop": "bun scripts/test-interop.ts"
  },
  "devDependencies": { "@types/bun": "1.4.2", "typescript": "6.0.3" }
}
